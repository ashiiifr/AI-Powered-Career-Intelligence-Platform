# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in your real values
# NEVER commit the real .env to Git
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── SQLite database path (optional — defaults to meetings.db next to app.py) ──
# DATABASE_PATH=meetings.db

# ── Zoom Server-to-Server OAuth ───────────────────────────────────────────────
# Create a Server-to-Server OAuth app at: https://marketplace.zoom.us
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ── Google Meet / Google Drive ────────────────────────────────────────────────
# One-time setup: python google_meet_adapter.py --auth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
