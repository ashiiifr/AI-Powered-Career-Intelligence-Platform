# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env

# ── SQLite database (generated at runtime) ───────────────────────────────────
meetings.db
*.db

# ── Python virtual environment ────────────────────────────────────────────────
myenv/
venv/
.venv/
env/

# ── Python bytecode & caches ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Whisper model weights (large binary files, downloaded on demand) ──────────
*.pt
*.bin

# ── Demo audio files (generated locally, not needed in the repo) ─────────────
demo_audio/

# ── Transcript output files ───────────────────────────────────────────────────
transcript_*.txt

# ── Jupyter / IPython ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor settings ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Streamlit local state ────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Temporary / log files ────────────────────────────────────────────────────
*.log
*.tmp
*.temp
